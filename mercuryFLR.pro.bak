TEMPLATE = app
TARGET = mercuryFLR
QT = core gui widgets

SOURCES += \
    src/main.cc \
    src/mainwindow.cc \
    src/initbuffers.cc \
    src/mercurysurface.cc

HEADERS += \
    include/mainwindow.h \
    include/initbuffers.h \
    include/mercurysurface.h

FORMS += \
    forms/mainwindow.ui

RESOURCES += resources.qrc
